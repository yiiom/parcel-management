      "user_id"
    ],
    "additionalProperties": false
  },
  "BuildingAdminAssign": {
    "oneOf": [
      {
        "$ref": "#/components/schemas/NewBuildingAdmin"
      },
      {
        "$ref": "#/components/schemas/ExistingBuildingAdmin"
      }
    ],
    "description": "二選一：提供新帳號資料，或提供既有管理員 user_id。不能同時提供。"
  },
  "BuildingAdmin": {
    "type": "object",
    "properties": {
