  "InviteCode": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "example": 21
      },
      "occupancy_id": {
        "type": "integer",
        "minimum": 1,
        "example": 7
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "expired",
          "inactive"
        ],
        "example": "active"
      },
      "expires_at": {
        "type": "string",
        "format": "date-time",
        "description": "固定為created_at加24小時，由後端產生。",
        "example": "2026-10-09T10:30:00+08:00"
      },
      "disabled_at": {
        "type": "string",
        "format": "date-time",
        "example": null,
        "nullable": true
      },
      "created_by": {
        "type": "integer",
        "minimum": 1,
        "example": 8
      },
      "created_at": {
        "type": "string",
        "format": "date-time",
        "example": "2026-10-08T10:30:00+08:00"
      }
    },
    "required": [
      "id",
      "occupancy_id",
      "status",
      "expires_at",
      "disabled_at",
      "created_by",
      "created_at"
    ],
    "description": "不含原始碼或雜湊。status 是由停用時間、到期時間、批次是否結束推導的 API 欄位。"
  },
  "InviteInput": {
    "type": "object",
    "properties": {
      "invite_code": {
        "type": "string",
        "pattern": "^[0-9]{4}$",
        "minLength": 4,
        "maxLength": 4,
        "description": "四位數字字串，保留開頭的0。",
        "example": "0382"
      }
    },
    "required": [
      "invite_code"
    ],
    "additionalProperties": false
  },
