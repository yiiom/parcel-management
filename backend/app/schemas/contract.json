      },
      "occupancy_id": {
        "type": "integer",
        "minimum": 1,
        "example": 7
      },
      "storage_location": {
        "type": "string",
        "maxLength": 100,
        "nullable": true,
        "example": "A 架第 2 層"
      }
    },
    "required": [],
    "additionalProperties": false,
    "minProperties": 1
  },
  "PickupCode": {
    "type": "object",
    "properties": {
      "parcel_id": {
        "type": "integer",
        "minimum": 1,
        "example": 125
      },
      "pickup_code": {
        "type": "string",
        "pattern": "^[0-9]{6}$",
        "description": "須保留字串型別，避免開頭的 0 消失。",
        "example": "582913"
      }
    },
    "required": [
      "parcel_id",
      "pickup_code"
