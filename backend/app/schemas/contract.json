{
  "Error": {
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "example": "FORBIDDEN"
      },
      "message": {
        "type": "string",
        "example": "你沒有權限執行此操作。"
      },
      "details": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "example": "email"
            },
            "message": {
              "type": "string",
              "example": "Email 格式不正確。"
            }
          },
          "required": [
            "field",
            "message"
          ]
        }
      }
    },
    "required": [
      "code",
      "message"
    ]
  },
  "Message": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string",
        "example": "操作成功。"
      }
    },
    "required": [
      "message"
    ]
  },
  "User": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "example": 12
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "example": "李佳穎"
      },
      "phone": {
        "type": "string",
        "minLength": 8,
        "maxLength": 20,
        "example": "0912345678"
      },
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 255,
        "example": "resident@example.com"
      },
      "role": {
        "type": "string",
        "enum": [
          "system_admin",
          "building_admin",
          "resident"
        ],
        "example": "resident"
      },
      "created_at": {
        "type": "string",
        "format": "date-time",
        "example": "2026-10-08T10:30:00+08:00"
      },
      "is_active": {
        "type": "boolean",
        "example": true
      },
      "updated_at": {
        "type": "string",
        "format": "date-time",
        "example": "2026-10-08T10:30:00+08:00"
      }
    },
    "required": [
      "id",
      "name",
      "phone",
      "email",
      "role",
      "created_at",
      "is_active",
      "updated_at"
    ]
  },
