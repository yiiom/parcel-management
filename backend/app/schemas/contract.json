  "Building": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "example": 1
      },
      "name": {
        "type": "string",
        "example": "森光花園",
        "maxLength": 100
      },
      "address": {
        "type": "string",
        "example": "台北市中山區森光路 18 號",
        "maxLength": 255
      },
      "phone": {
        "type": "string",
        "minLength": 8,
        "maxLength": 20,
        "example": "0912345678",
        "nullable": true
