      },
      "updated_at": {
        "type": "string",
        "format": "date-time",
        "example": "2026-10-08T10:30:00+08:00"
      }
    },
    "required": [
      "id",
      "name",
      "address",
      "phone",
      "created_at",
      "can_delete",
      "updated_at"
    ]
  },
