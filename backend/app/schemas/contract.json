          "$ref": "#/components/schemas/Membership"
        }
      },
      "managed_building_ids": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1,
          "example": 1
        }
      }
    },
    "required": [
      "user",
      "memberships",
      "managed_building_ids"
    ]
  },
  "Parcel": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "example": 125
      },
      "building_id": {
        "type": "integer",
        "minimum": 1,
        "example": 1
      },
      "unit_id": {
        "type": "integer",
        "minimum": 1,
        "example": 501
      },
      "unit_label": {
        "type": "string",
        "example": "A 棟 5 樓之 1"
      },
      "recipient_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "example": "李佳穎"
      },
      "tracking_number": {
        "type": "string",
        "nullable": true,
        "example": "TC26007128"
      },
      "note": {
        "type": "string",
        "nullable": true,
        "example": "外箱完整"
      },
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "picked_up",
          "exception",
          "returned"
        ],
        "example": "pending"
      },
      "created_by": {
        "type": "integer",
        "minimum": 1,
        "example": 8
      },
      "picked_up_at": {
        "type": "string",
        "format": "date-time",
        "example": null,
        "nullable": true
      },
      "active_verification_id": {
        "type": "integer",
        "minimum": 1,
        "nullable": true,
        "example": 81,
        "description": "有效的本次取件驗證 ID；未驗證、過期或完成後為 null。"
      },
      "occupancy_id": {
        "type": "integer",
        "minimum": 1,
        "example": 7
      },
      "courier": {
        "type": "string",
        "nullable": true,
        "example": "黑貓宅急便"
      },
      "created_at": {
        "type": "string",
        "format": "date-time",
        "example": "2026-10-08T10:30:00+08:00"
      },
      "storage_location": {
        "type": "string",
        "nullable": true,
        "example": "A 架第 2 層"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time",
        "example": "2026-10-08T10:30:00+08:00"
      },
      "exception_reason": {
        "type": "string",
        "nullable": true
      },
      "exception_reported_by": {
        "type": "integer",
        "nullable": true
      },
      "exception_reported_at": {
        "type": "string",
        "format": "date-time",
        "example": null,
        "nullable": true
      },
      "resolution_note": {
        "type": "string",
        "nullable": true
      },
      "resolved_by": {
        "type": "integer",
        "nullable": true
      },
      "resolved_at": {
        "type": "string",
        "format": "date-time",
        "example": null,
        "nullable": true
      }
    },
    "required": [
      "id",
      "building_id",
      "unit_id",
      "unit_label",
      "recipient_name",
      "tracking_number",
      "note",
      "status",
      "created_by",
      "picked_up_at",
      "active_verification_id",
      "occupancy_id",
      "courier",
      "created_at",
      "storage_location",
      "updated_at",
      "exception_reason",
      "exception_reported_by",
      "exception_reported_at",
      "resolution_note",
      "resolved_by",
      "resolved_at"
    ],
    "description": "大樓、戶別、簽收時間與有效驗證 ID 為關聯／衍生欄位。只保留最近一次異常資料，不回傳取件碼密文。"
  },
  "ParcelCreate": {
    "type": "object",
    "properties": {
      "recipient_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "example": "李佳穎"
      },
      "tracking_number": {
        "type": "string",
        "maxLength": 100,
        "nullable": true,
        "example": "TC26007128"
      },
      "note": {
        "type": "string",
        "nullable": true,
        "example": "外箱完整"
      },
      "courier": {
        "type": "string",
        "maxLength": 100,
        "nullable": true,
        "example": "黑貓宅急便"
      },
      "occupancy_id": {
        "type": "integer",
        "minimum": 1,
        "example": 7
      },
      "storage_location": {
        "type": "string",
        "maxLength": 100,
        "nullable": true,
        "example": "A 架第 2 層"
      },
      "duplicate_confirmed": {
        "type": "boolean",
        "default": false,
        "description": "管理員看過同棟相同物流與單號的既有紀錄並確認後才送true；不是一般表單預設值，不擴大權限。"
      }
    },
    "required": [
      "occupancy_id",
      "recipient_name"
    ],
    "additionalProperties": false
  },
  "ParcelUpdate": {
    "type": "object",
    "properties": {
      "recipient_name": {
        "type": "string",
